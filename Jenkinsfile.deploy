// Fixed-main job. Started by deploy-dev.sh through the Jenkins API.
pipeline {
    agent { label 'chatting-alarm-deploy' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    environment {
        AWS_REGION = 'ap-northeast-2'
        AWS_DEFAULT_REGION = 'ap-northeast-2'
    }
    stages {
        stage('Checkout main') {
            steps {
                deleteDir()
                checkout scm
                sh 'test "$(git rev-parse HEAD)" = "$(git rev-parse refs/remotes/origin/main)"'
            }
        }
        stage('Verify release') {
            steps {
                dir('backend') { sh 'mvn --batch-mode test' }
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
            post {
                always { junit testResults: 'backend/target/surefire-reports/*.xml', allowEmptyResults: true }
            }
        }
        stage('Build and deploy to EKS') {
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail
terraform -chdir=infra/aws init -input=false -lockfile=readonly
bash infra/scripts/deploy-eks.sh
'''
            }
        }
    }
    post {
        success { archiveArtifacts artifacts: 'deployment-info.json', fingerprint: true }
    }
}
